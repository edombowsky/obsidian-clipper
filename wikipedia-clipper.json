{
	"schemaVersion": "0.1.0",
	"name": "Wikipedia",
	"behavior": "create",
	"noteContentFormat": "{{selectorHtml:#mw-content-text|remove_html:(\".navbox,.printfooter,.side-box\")|markdown}}",
	"properties": [
		{
			"name": "categories",
			"value": "[[Clippings]]",
			"type": "multitext"
		},
		{
			"name": "types",
			"value": "[[Wikipedia]]",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "[[Wikipedia]]",
			"type": "multitext"
		},
		{
			"name": "clipped",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "min_to_read",
			"value": "{{content|strip_md|split:\\\" \\\"|length|calc:\\\"/260\\\"|round}}",
			"type": "text"
		},
		{
			"name": "obsidianUIMode",
			"value": "preview",
			"type": "text"
		}
	],
	"triggers": [
		"/^https:\\/\\/[a-z-.]+\\.wikipedia\\.org\\/wiki\\/.*$/"
	],
	"noteNameFormat": "{{title}}",
	"path": "30 Sources/Clippings"
}