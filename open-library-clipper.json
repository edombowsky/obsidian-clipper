{
	"schemaVersion": "0.1.0",
	"name": "Open Library",
	"behavior": "create",
	"noteContentFormat": "{{description}}",
	"properties": [
		{
			"name": "Title",
			"value": "{{selector:h1[itemprop='name']|first}}",
			"type": "text"
		},
		{
			"name": "Author",
			"value": "{{selector:a[itemprop='author']|first|wikilink}}",
			"type": "multitext"
		},
		{
			"name": "year",
			"value": "{{selector:span[itemprop='datePublished']|first}}",
			"type": "number"
		},
		{
			"name": "Cover",
			"value": "{{meta:property:og:image}}",
			"type": "text"
		},
		{
			"name": "isbn",
			"value": "{{selector:dd[itemprop='isbn']|first}}",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{time|date:"YYYY-MM-DDTHH:mm:ss.SSS ZZ"}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "Type/book",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://openlibrary.org/"
	],
	"noteNameFormat": "{{selector:h1[itemprop='name']|first}}",
	"path": "Notes/Books"
}
