{
	"schemaVersion": "0.1.0",
	"name": "IMDB",
	"behavior": "create",
	"noteContentFormat": "",
	"properties": [
		{
			"name": "categories",
			"value": "[[Movies]]",
			"type": "multitext"
		},
		{
			"name": "genre",
			"value": "{{schema:genre|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "director",
			"value": "{{selector:[data-testid=\\\"title-pc-principal-credit\\\"]:first-child a|unique|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "rating",
			"value": "{{selector:[data-testid=\\\"hero-rating-bar__user-rating__score\\\"] span|unique}}",
			"type": "number"
		},
		{
			"name": "scoreImdb",
			"value": "{{schema:aggregateRating.ratingValue}}",
			"type": "number"
		},
		{
			"name": "cast",
			"value": "{{selector:[data-testid=\\\"title-pc-principal-credit\\\"]:nth-child(3) div a|unique|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "cover",
			"value": "{{schema:image}}",
			"type": "text"
		},
		{
			"name": "plot",
			"value": "{{schema:description}}",
			"type": "text"
		},
		{
			"name": "year",
			"value": "{{schema:datePublished|split:\\\"-\\\"|slice:0,1}}",
			"type": "number"
		},
		{
			"name": "created",
			"value": "{{time|date:"YYYY-MM-DDTHH:mm:ss.SSS ZZ"}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "movies, review, to-watch, clipping",
			"type": "multitext"
		},
		{
			"name": "obsidianUIMode",
			"value": "preview",
			"type": "text"
		}
	],
	"triggers": [
		"https://www.imdb.com"
	],
	"noteNameFormat": "{{schema:name}}",
	"path": "References"
}
